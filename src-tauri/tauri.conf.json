{
  "$schema": "https://v2.tauri.app/schemas/config.schema.json",
  "productName": "NTD",
  "version": "0.2.0",
  "identifier": "com.ntd.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "NTD - Nothing Todo",
      "width": 1200,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "backgroundColor": "#0f172a"
    }],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": []
  },
  "plugins": {
    "shell": { "open": true }
  }
}
